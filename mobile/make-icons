#!/bin/sh
# Makes every icon and splash screen from the logos in docs: the web
# app's (web/public) and the Android app's launcher icons and splash
# screens. logo.svg is the bird on its branch (the top bar, splash
# screens); logo-tile.svg its head on a rounded tile (browser tabs,
# installed app); logo-head.svg the head alone, laid on the background
# for icons the platform cuts to a shape of its own. Run again after
# changing a logo. Needs rsvg-convert and ImageMagick.
set -eu
top=$(cd "$(dirname "$0")/.." && pwd)
logo=$top/docs/logo.svg
tile=$top/docs/logo-tile.svg
head=$top/docs/logo-head.svg
bg='#f3efe6'          # the icons' background, a warm off-white
res=$top/mobile/android/app/src/main/res
public=$top/web/public
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# render SIZE OUT [SVG]: the logo (or SVG) alone, transparent, SIZE pixels square.
render() { rsvg-convert -w "$1" -h "$1" "${3:-$logo}" -o "$2"; }
# full SIZE OUT [round]: the head over the whole background, square or
# (round) a circle.
full() {
    render "$1" "$tmp/head.png" "$head"
    magick -size "$1x$1" "xc:$bg" "$tmp/head.png" -composite "$tmp/full.png"
    if [ "${3:-}" = round ]; then
        magick "$tmp/full.png" -alpha set \( -size "$1x$1" xc:none -fill white -draw "circle $(( $1 / 2 )),$(( $1 / 2 )) $(( $1 / 2 )),0" \) \
            -compose DstIn -composite "$2"
    else
        cp "$tmp/full.png" "$2"
    fi
}

# Web: the bird for the top bar, the tile for tabs and installed apps,
# and the head over the whole square where the platform rounds it (iOS)
# or cuts it to a shape (maskable).
mkdir -p "$public"
cp "$logo" "$public/logo.svg"
cp "$tile" "$public/favicon.svg"
full 180 "$public/apple-touch-icon.png"
render 192 "$public/icon-192.png" "$tile"
render 512 "$public/icon-512.png" "$tile"
full 512 "$public/icon-maskable-512.png"

# Android launcher icons: legacy square and round, and the adaptive
# icon's foreground (108 dp, of which the middle 66 dp is always shown).
for d in mdpi:48 hdpi:72 xhdpi:96 xxhdpi:144 xxxhdpi:192; do
    dens=${d%:*}; size=${d#*:}
    render "$size" "$res/mipmap-$dens/ic_launcher.png" "$tile"
    full "$size" "$res/mipmap-$dens/ic_launcher_round.png" round
    fg=$(( size * 108 / 48 ))
    render "$fg" "$res/mipmap-$dens/ic_launcher_foreground.png" "$head"
done
cat > "$res/values/ic_launcher_background.xml" <<EOF
<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">$bg</color>
</resources>
EOF

# Splash screens: the logo at 40 per cent of the shorter side, centred,
# at each size the project already has.
for f in "$res"/drawable*/splash.png; do
    geom=$(magick identify -format '%w %h' "$f")
    w=${geom% *}; h=${geom#* }
    short=$(( w < h ? w : h ))
    render $(( short * 40 / 100 )) "$tmp/splash.png"
    magick -size "${w}x${h}" "xc:$bg" "$tmp/splash.png" -gravity center -composite "$f"
done
echo "icons made from $logo"
