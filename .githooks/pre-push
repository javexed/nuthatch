#!/usr/bin/env bash
# Leak gate on what is being pushed: secrets, private addresses and, where
# a private list is declared, the names on it, before anything leaves the
# machine. Only `git push --no-verify` passes it by.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
REMOTE="${1:-origin}"
status=0
ZERO=0000000000000000000000000000000000000000
# stdin: <local-ref> <local-sha> <remote-ref> <remote-sha> for each ref.
while read -r _lref lsha _rref _rsha; do
  [ -z "${lsha:-}" ] && continue
  [ "$lsha" = "$ZERO" ] && continue                    # a branch taken away
  # What this branch adds to main: right for a new branch, an update, and a
  # push after a rebase alike.
  base=$(git merge-base "$REMOTE/main" "$lsha" 2>/dev/null || true)
  [ -n "$base" ] && range="$base..$lsha" || range="$lsha"
  bash "$ROOT/scripts/leak-scan.sh" --range "$range" || status=1
done
[ "$status" -eq 0 ] || { echo "pre-push: the leak gate stopped the push." >&2; exit 1; }
exit 0
