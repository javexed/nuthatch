#!/usr/bin/env bash
# checkd and nuthatch on this machine, from your own account, without
# root: builds both, writes a first config that watches this machine,
# sets the password of the first user, who may do everything, and starts
# both as user services. The steps by hand: docs/install.md.
#
#   git clone https://github.com/javexed/checkd.git ~/checkd
#   git clone https://github.com/javexed/nuthatch.git ~/nuthatch
#   ~/nuthatch/contrib/quick-start
#
# It asks a few questions. Each has an option, and with --yes it asks
# nothing; the password then comes from --password-file, or stdin:
#
#   ~/nuthatch/contrib/quick-start --yes --port 7780 --password-file pw.txt
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: contrib/quick-start [options]

  --port N             port of the web interface, on 127.0.0.1 (7780)
  --user NAME          the first user, who may do everything (admin)
  --password-file F    that user's password: the first line of F, "-" for
                       stdin
  --checkd-src DIR     the checkd clone (~/checkd)
  --no-linger          both stop when you log out
  -y, --yes            ask nothing
  -h, --help           this
EOF
}

nuthatch=$(cd "$(dirname "$0")/.." && pwd)
checkd=${CHECKD_SRC:-$HOME/checkd}
port=${PORT:-7780}
user=admin
password_file=
linger=1
interactive=1
[ -t 0 ] || interactive=0
me=${USER:-$(id -un)}
run=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
config=${XDG_CONFIG_HOME:-$HOME/.config}
state=$HOME/.local/state

fail() { echo "quick-start: $*" >&2; exit 1; }
step() { printf '\n== %s\n' "$*"; }
value() { [ $# -ge 2 ] && [ -n "$2" ] || fail "$1 needs a value"; }

while [ $# -gt 0 ]; do
    case $1 in
        --port) value "$@"; port=$2; shift 2 ;;
        --user) value "$@"; user=$2; shift 2 ;;
        --password-file) value "$@"; password_file=$2; shift 2 ;;
        --checkd-src) value "$@"; checkd=$2; shift 2 ;;
        --no-linger) linger=0; shift ;;
        -y|--yes) interactive=0; shift ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; fail "unknown option: $1" ;;
    esac
done
if [ -z "$password_file" ] && [ $interactive = 0 ]; then
    [ -t 0 ] && fail "--yes needs --password-file, or the password on stdin"
    password_file=-
fi

# ask VAR "question": the current value is the default, kept on Enter.
ask() {
    local answer
    read -r -p "$2 [${!1}]: " answer
    [ -z "$answer" ] || printf -v "$1" '%s' "$answer"
}
isyes() { case $1 in y|Y|yes|Yes|YES) return 0 ;; *) return 1 ;; esac; }

if [ $interactive = 1 ]; then
    echo "checkd and nuthatch for $me on this machine. Enter keeps what is in [ ]."
    ask port "Port"
    ask user "First user"
    keep=y
    [ $linger = 1 ] || keep=n
    ask keep "Keep running after you log out (y/n)"
    if isyes "$keep"; then linger=1; else linger=0; fi
fi

case $port in ''|*[!0-9]*) fail "port $port is not a number" ;; esac
[ "$port" -ge 1 ] && [ "$port" -le 65535 ] || fail "port $port is out of range"
case $user in ''|*[!A-Za-z0-9._-]*) fail "user $user: letters, digits, '.', '_' and '-' only" ;; esac

# What it needs, before anything is changed.
[ "$nuthatch" = "$HOME/nuthatch" ] || fail "nuthatch must be in ~/nuthatch (its user service runs from there), not $nuthatch"
[ -d "$checkd/.git" ] || fail "no checkd in $checkd: git clone https://github.com/javexed/checkd.git ~/checkd"
command -v cargo >/dev/null || fail "cargo is missing: install Rust (https://rustup.rs)"
node=$(command -v node) || fail "node is missing: install Node 22.18 or later"
"$node" -e 'const [a,b]=process.versions.node.split(".").map(Number);process.exit(a>22||(a===22&&b>=18)?0:1)' \
    || fail "Node $("$node" --version) is too old: 22.18 or later"
command -v pnpm >/dev/null || command -v corepack >/dev/null || fail "pnpm is missing: install pnpm, or a Node that has corepack"
command -v openssl >/dev/null || fail "openssl is missing"
command -v systemctl >/dev/null || fail "systemd is needed for the user services"
systemctl --user show-environment >/dev/null 2>&1 || fail "no systemd user manager for $me (log in on a console or over SSH, not su)"
for f in "$config/checkd/naemon.cfg" "$config/nuthatch/nuthatch.toml"; do
    [ -e "$f" ] && fail "$f is there already: nothing changed (the steps by hand are in docs/install.md)"
done

# The password before the builds, so that a long build is not followed
# by a question.
if [ -n "$password_file" ]; then
    pw=
    if [ "$password_file" = - ]; then
        IFS= read -r pw || true
    else
        [ -r "$password_file" ] || fail "cannot read $password_file"
        IFS= read -r pw < "$password_file" || true
    fi
    [ -n "$pw" ] || fail "the password is empty"
    hash=$(printf '%s\n' "$pw" | openssl passwd -6 -stdin)
    unset pw
else
    echo "Password of $user:"
    hash=$(openssl passwd -6) || fail "no password set"
fi

if [ $interactive = 1 ]; then
    if [ $linger = 1 ]; then after="keeps running after you log out"; else after="stops when you log out"; fi
    printf '\nhttp://127.0.0.1:%s, user %s, %s.\n' "$port" "$user" "$after"
    go=y
    ask go "Build and start (y/n)"
    isyes "$go" || fail "stopped: nothing changed"
fi

step "checkd: building"
(cd "$checkd" && cargo build --release -p checkd)
install -Dm 755 "$checkd/target/release/checkd" "$HOME/.local/bin/checkd"

step "checkd: a first config in $config/checkd"
mkdir -p "$config/checkd/objects" "$config/checkd/managed" "$state/checkd"
cat > "$config/checkd/naemon.cfg" <<EOF
cfg_dir=$config/checkd/objects
cfg_dir=$config/checkd/managed
resource_file=$config/checkd/resource.cfg
check_external_commands=1
command_file=$run/checkd/checkd.cmd
lock_file=$run/checkd/checkd.pid
log_file=$state/checkd/checkd.log
retain_state_information=1
state_retention_file=$state/checkd/retention.dat
temp_path=$state/checkd
EOF
echo '$USER1$=/usr/lib/monitoring-plugins' > "$config/checkd/resource.cfg"
# The contact is the first user, so that the user sees what it is sent.
sed -E "s/^(\s*(contact_name|contacts)\s+)admin$/\1$user/" \
    "$nuthatch/contrib/start/start.cfg" > "$config/checkd/objects/start.cfg"
"$HOME/.local/bin/checkd" verify "$config/checkd/naemon.cfg"

step "nuthatch: building"
cd "$nuthatch"
# Running this is the yes to corepack fetching pnpm.
export COREPACK_ENABLE_DOWNLOAD_PROMPT=0
# Without pnpm on the PATH, corepack's, for the scripts that call pnpm too.
if ! command -v pnpm >/dev/null; then
    shim=$(mktemp -d)
    trap 'rm -rf "$shim"' EXIT
    printf '#!/bin/sh\nexec corepack pnpm "$@"\n' > "$shim/pnpm"
    chmod +x "$shim/pnpm"
    PATH=$shim:$PATH
fi
pnpm install --frozen-lockfile
pnpm build

step "nuthatch: a first config in $config/nuthatch"
mkdir -p "$config/nuthatch" "$state/nuthatch"
(umask 077 && printf '%s:%s\n' "$user" "$hash" > "$config/nuthatch/htpasswd")
roles=
for r in all_hosts all_services all_host_commands all_service_commands \
    system_commands system_information configuration_information config_edit; do
    roles+="authorized_for_$r = [\"$user\"]"$'\n'
done
cat > "$config/nuthatch/nuthatch.toml" <<EOF
listen = "127.0.0.1:$port"
web_root = "$nuthatch/web/dist"
store = "$state/nuthatch/nuthatch.sqlite"
htpasswd = "$config/nuthatch/htpasswd"

[roles]
$roles
[[backend]]
name = "checkd"
livestatus = "unix:$run/checkd/live"

[backend.config]
dir = "$config/checkd/managed"
main = "$config/checkd/naemon.cfg"
verify = ["$HOME/.local/bin/checkd", "verify", "--quiet", "{main}"]
EOF

step "starting both"
install -Dm 644 "$checkd/contrib/systemd/checkd-user.service" "$config/systemd/user/checkd.service"
# The unit names /usr/bin/node; this one is the node found above.
sed "s#^ExecStart=/usr/bin/node #ExecStart=$node #" "$nuthatch/contrib/systemd/nuthatch-user.service" \
    > "$config/systemd/user/nuthatch.service"
systemctl --user daemon-reload
systemctl --user enable --now checkd nuthatch
if [ $linger = 1 ] && [ "$(loginctl show-user "$me" -p Linger --value 2>/dev/null)" != yes ]; then
    loginctl enable-linger "$me" 2>/dev/null || echo "(loginctl enable-linger failed: both stop when you log out)"
fi

for _ in $(seq 30); do
    if "$node" -e "fetch('http://127.0.0.1:$port/').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"; then
        printf '\nReady: http://127.0.0.1:%s, user %s.\n' "$port" "$user"
        echo "From other machines: tailscale serve, or a proxy that does TLS (README)."
        exit 0
    fi
    sleep 1
done
fail "nuthatch does not answer on port $port: journalctl --user -u nuthatch -u checkd"
