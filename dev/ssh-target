#!/usr/bin/env bash
# A host to install agents on over SSH, for web/e2e/agents-ssh.spec.ts: a
# Debian container that runs systemd, with an SSH server on port 2222 and
# the user admin (password "admin-pass", sudo with that password). It
# shares this machine's network, so that it reaches the dev nuthatch and
# checkd at 127.0.0.1 as a monitored host would reach them; its SSH server
# listens on 127.0.0.1 alone, as its password is no secret. It
# does not hold back after a wrong login (PerSourcePenalties), so that a
# test can try a wrong password and then the right one.
#
#   dev/ssh-target          start it (again)
#   dev/ssh-target stop
set -euo pipefail
name=nuthatch-ssh-target
image=nuthatch-ssh-target:3

docker rm -f "$name" >/dev/null 2>&1 || true
[ "${1:-}" = stop ] && exit 0

if ! docker image inspect "$image" >/dev/null 2>&1; then
    docker build -q -t "$image" - >/dev/null <<'EOF'
FROM debian:trixie
RUN apt-get update && apt-get install -y --no-install-recommends systemd systemd-sysv openssh-server sudo curl ca-certificates procps \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -s /bin/bash -G sudo admin && echo 'admin:admin-pass' | chpasswd \
    && printf 'Port 2222\nListenAddress 127.0.0.1\nPasswordAuthentication yes\nPermitRootLogin no\nPerSourcePenalties no\n' > /etc/ssh/sshd_config.d/test.conf \
    && systemctl enable ssh
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
EOF
fi

docker run -d -t --name "$name" --network host --cap-add SYS_ADMIN --cgroupns=private \
    --tmpfs /run --tmpfs /tmp -e container=docker "$image" \
    sh -c 'mount -o remount,rw /sys/fs/cgroup && exec /sbin/init' >/dev/null
for _ in $(seq 60); do
    ssh-keyscan -T 2 -p 2222 127.0.0.1 >/dev/null 2>&1 && { echo "SSH at 127.0.0.1:2222, user admin"; exit 0; }
    sleep 1
done
echo "no SSH server came up" >&2
exit 1
