#!/usr/bin/env bash
# Stops an engine started with dev/up and starts it again, as a restart
# of the service would: for the tests of what must outlast one.
#
#   dev/restart naemon|checkd
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
case ${1:-} in
naemon)
    docker restart nuthatch-dev-naemon >/dev/null
    ;;
checkd)
    pid=$(cat "$here/run/checkd/pid")
    kill "$pid"
    while kill -0 "$pid" 2>/dev/null; do sleep 0.2; done
    CHECKD=${CHECKD:-$here/../../checkd/target/debug/checkd} nohup "$here/up" checkd >> "$here/run/checkd/stdout.log" 2>&1 &
    ;;
*)
    echo "usage: dev/restart naemon|checkd" >&2
    exit 2
    ;;
esac
for _ in $(seq 100); do
    [ -S "$here/run/$1/live" ] && exit 0
    sleep 0.2
done
echo "$1 did not come back" >&2
exit 1
