#!/usr/bin/env python3
"""Who may see and do what: the test of nuthatch's permissions.

    dev/matrix

Needs `dev/up naemon` and `dev/up checkd` running. Starts a nuthatch of its
own (port 8091, a store of its own), logs in as each user of the demo site
and tries every table and a set of commands on each engine, then compares
with what must happen:

  admin     all roles
  viewer    sees everything (group admins), read-only
  ops       contact of web1, web2 and the service db1/postgres
  nobody    a contact of nothing, who may send no commands
  stranger  a login that is no contact

An engine that does not limit what a user sees (no AuthUser) must be closed
to ops, nobody and stranger altogether; open to admin and viewer.

    dev/matrix --federated

The same, asked of a central nuthatch that has no engine of its own: it
reaches each engine through a nuthatch at its "site" (ports 8093 and
8094), with a key. And then what a key is for: a wrong one, and one that
may only read.
"""
import http.cookiejar
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
PORT = 8091
BASE = f"http://127.0.0.1:{PORT}"
PASSWORD = "matrix-" + os.urandom(6).hex()
USERS = ["admin", "viewer", "ops", "nobody", "stranger"]
FEDERATED = "--federated" in sys.argv[1:]
failures = []


def check(what, got, want):
    if got == want:
        print(f"ok    {what}")
    else:
        print(f"FAIL  {what}: got {got!r}, wanted {want!r}")
        failures.append(what)


class Client:
    def __init__(self):
        self.opener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(http.cookiejar.CookieJar()))
        self.csrf = None
        self.token = None
        self.base = BASE

    def call(self, method, path, body=None, csrf=True, headers=None):
        request = urllib.request.Request(self.base + path, method=method)
        if body is not None:
            request.data = json.dumps(body).encode()
            request.add_header("Content-Type", "application/json")
        if csrf and self.csrf:
            request.add_header("X-Nuthatch-CSRF", self.csrf)
        if self.token:
            request.add_header("Authorization", "Bearer " + self.token)
        for name, value in (headers or {}).items():
            request.add_header(name, value)
        opener = urllib.request.build_opener() if self.token else self.opener
        try:
            with opener.open(request, timeout=90) as answer:
                return answer.status, json.loads(answer.read() or b"null")
        except urllib.error.HTTPError as err:
            text = err.read()
            try:
                return err.code, json.loads(text)
            except ValueError:
                return err.code, {"error": text.decode(errors="replace")}

    def login(self, user, password=PASSWORD):
        status, body = self.call("POST", "/api/v1/login", {"user": user, "password": password})
        if status == 200:
            self.csrf = body["csrf"]
        return status

    def rows(self, backend, table, columns, headers=()):
        """The number of rows, or the HTTP status when refused, or 'closed'
        when the backend is not asked for this user."""
        status, body = self.call("POST", "/api/v1/query", {"table": table, "columns": columns, "headers": list(headers), "backends": [backend]})
        if status != 200:
            return status
        if body["errors"]:
            return "closed" if "does not limit" in body["errors"][backend] else body["errors"][backend]
        return len(body["rows"])

    def command(self, backend, name, *args):
        status, _ = self.call("POST", "/api/v1/command", {"backend": backend, "command": name, "args": [str(a) for a in args]})
        return status


def main():
    run = os.path.join(HERE, "run")
    for engine in ("naemon", "checkd"):
        if not os.path.exists(os.path.join(run, engine, "live")):
            sys.exit(f"dev/up {engine} is not running")
    # Hosts that an earlier, broken-off run added go, and the engine is
    # told.
    for engine in ("naemon", "checkd"):
        managed = os.path.join(run, engine, "managed")
        left = os.listdir(managed)
        for name in left:
            os.remove(os.path.join(managed, name))
        if left:
            subprocess.run([os.path.join(HERE, "restart"), engine], check=True)
            time.sleep(3)
    work = os.path.join(run, "matrix")
    os.makedirs(work, exist_ok=True)
    for name in os.listdir(work):
        os.remove(os.path.join(work, name))
    with open(os.path.join(work, "htpasswd"), "w") as out:
        for user in USERS:
            hashed = subprocess.run(["openssl", "passwd", "-apr1", PASSWORD], capture_output=True, text=True, check=True).stdout.strip()
            out.write(f"{user}:{hashed}\n")
    config = open(os.path.join(HERE, "nuthatch.toml")).read()
    config = config.replace("dev/run/htpasswd", "dev/run/matrix/htpasswd")
    top, _, backends = config.partition("[[backend]]")
    servers = []

    def start(name, port, text):
        text = text.replace('listen = "127.0.0.1:8080"', f'listen = "127.0.0.1:{port}"').replace("dev/run/nuthatch.sqlite", f"dev/run/matrix/{name}.sqlite")
        with open(os.path.join(work, f"{name}.toml"), "w") as out:
            out.write(text)
        log = open(os.path.join(work, f"{name}.log"), "w")
        servers.append(subprocess.Popen(["node", "--disable-warning=ExperimentalWarning", "server/src/main.ts", f"dev/run/matrix/{name}.toml"], cwd=ROOT, stderr=log))
        for _ in range(50):
            try:
                urllib.request.urlopen(f"http://127.0.0.1:{port}/api/v1/session", timeout=1)
            except urllib.error.HTTPError:
                break
            except OSError:
                time.sleep(0.1)

    try:
        if FEDERATED:
            # A nuthatch at each engine's site, which lets the central one in
            # by a key, and lets it change the config; the central one has no
            # engine of its own.
            keys = {}
            for kind in ("central", "reader", "stranger"):
                keys[kind] = os.path.join(work, f"{kind}.key")
                with open(keys[kind], "w") as out:
                    out.write(os.urandom(24).hex())
            sites = {"naemon": 8093, "checkd": 8094}
            for site, port in sites.items():
                own = "[[backend]]" + [part for part in backends.split("[[backend]]") if f'name = "{site}"' in part][0]
                peers = f'\n[[peer]]\nname = "central"\nkey_file = "{keys["central"]}"\nconfig = true\n\n[[peer]]\nname = "reader"\nkey_file = "{keys["reader"]}"\nread_only = true\n'
                start(f"site-{site}", port, top + own + peers)
            remote = "".join(f'[[backend]]\nname = "{site}"\nnuthatch = "http://127.0.0.1:{port}"\nkey_file = "{keys["central"]}"\n\n' for site, port in sites.items())
            start("nuthatch", PORT, top + remote)
            tests()
            # What a key is for.
            print("\n== keys")
            for kind, port in (("reader", 8095), ("stranger", 8096)):
                remote = f'[[backend]]\nname = "naemon"\nnuthatch = "http://127.0.0.1:8093"\nkey_file = "{keys[kind]}"\n'
                start(f"central-{kind}", port, top + remote)
                client = Client()
                client.base = f"http://127.0.0.1:{port}"
                check(f"admin logs in at the nuthatch with the key of {kind}", client.login("admin"), 200)
                if kind == "reader":
                    check("a key that may only read: reads", client.rows("naemon", "hosts", ["name"]), 11)
                    check("a key that may only read: sends no command", client.command("naemon", "ADD_HOST_COMMENT", "web1", 1, "x", "by a reader"), 403)
                    check("a key that may only read: changes no config", client.call("GET", "/api/v1/config/naemon")[0], 403)
                else:
                    status, body = client.call("POST", "/api/v1/query", {"table": "hosts", "columns": ["name"]})
                    check("a key the site does not know: nothing, and the user stays logged in", (status, "key" in body.get("error", ""), client.call("GET", "/api/v1/tokens")[0]), (502, True, 200))
                    check("a key the site does not know: no command", client.command("naemon", "ADD_HOST_COMMENT", "web1", 1, "x", "by a stranger"), 502)
        else:
            start("nuthatch", PORT, top + "[[backend]]" + backends)
            tests()
    finally:
        for server in servers:
            server.terminate()
        for server in servers:
            server.wait()
    print()
    if failures:
        print(f"{len(failures)} checks failed.")
        sys.exit(1)
    print("All permission checks passed.")


def tests():
    # Before anyone is known.
    anonymous = Client()
    check("no login: the session is refused", anonymous.call("GET", "/api/v1/session")[0], 401)
    check("no login: a query is refused", anonymous.rows("naemon", "hosts", ["name"]), 401)
    check("a wrong password is refused", Client().login("admin", "wrong"), 401)
    check("an unknown user is refused", Client().login("ghost"), 401)

    clients = {}
    for user in USERS:
        clients[user] = Client()
        check(f"{user} logs in", clients[user].login(user), 200)
    admin = clients["admin"]
    session = admin.call("GET", "/api/v1/session")[1]
    limits = {b["name"]: b["limits_users"] for b in session["backends"]}
    print(f"      backends limit users: {limits}")
    check("both engines limit what a user sees", limits, {"naemon": True, "checkd": True})
    roles = {user: sorted(clients[user].call("GET", "/api/v1/session")[1]["roles"]) for user in USERS}
    check("admin's roles", roles["admin"], sorted(["all_hosts", "all_host_commands", "system_commands", "system_information", "configuration_information", "config_edit"]))
    check("viewer's roles", roles["viewer"], ["all_hosts", "read_only"])
    check("ops has no roles", roles["ops"], [])

    # What a request may not carry, whoever sends it.
    check("a header that is no filter is refused", admin.rows("naemon", "hosts", ["name"], ["AuthUser: admin"]), 400)
    check("a header of two lines is refused", admin.rows("naemon", "hosts", ["name"], ["Filter: state = 0\nCOMMAND [1] SHUTDOWN_PROGRAM"]), 400)
    check("a cookie without the CSRF header changes nothing", admin.call("POST", "/api/v1/query", {"table": "hosts", "columns": ["name"]}, csrf=False)[0], 403)
    check("a command nuthatch does not send is refused", admin.command("naemon", "SHUTDOWN_PROGRAM"), 400)
    check("a secret column needs a role: ops", clients["ops"].rows("naemon", "hosts", ["name", "check_command"]), 400)
    check("a filter on a secret column needs a role: ops", clients["ops"].rows("naemon", "hosts", ["name"], ["Filter: check_command ~ demo"]), 400)
    check("a secret column: admin", admin.rows("naemon", "hosts", ["name", "check_command"]), 11)

    # A token stands for its user, and needs no CSRF header.
    status, made = clients["ops"].call("POST", "/api/v1/tokens", {"name": "matrix"})
    check("ops makes a token", status, 200)
    with_token = Client()
    with_token.token = made.get("token")
    check("the token sees what ops sees", with_token.rows("naemon", "hosts", ["name"]), 2)
    check("a token cannot make a token", with_token.call("POST", "/api/v1/tokens", {"name": "more"})[0], 403)
    check("the token is deleted", clients["ops"].call("DELETE", f"/api/v1/tokens/{made.get('id')}")[0], 200)
    check("a deleted token is refused", with_token.rows("naemon", "hosts", ["name"]), 401)

    for backend in ("naemon", "checkd"):
        closed = not limits[backend]
        print(f"\n== {backend}" + (" (does not limit users: closed to those without all_hosts)" if closed else ""))
        # Comments of earlier runs go first.
        for _ in range(20):
            status, body = admin.call("POST", "/api/v1/query", {"table": "comments", "columns": ["id", "is_service"], "backends": [backend]})
            if not body["rows"]:
                break
            for row in body["rows"]:
                admin.command(backend, "DEL_SVC_COMMENT" if row["is_service"] else "DEL_HOST_COMMENT", row["id"])
            time.sleep(1)
        # Comments by admin, for the others to try to delete.
        check(f"{backend}: admin comments on db1", admin.command(backend, "ADD_HOST_COMMENT", "db1", 1, "x", "matrix db1"), 200)
        check(f"{backend}: admin comments on web1", admin.command(backend, "ADD_HOST_COMMENT", "web1", 1, "x", "matrix web1"), 200)
        ids = {}
        for _ in range(30):
            status, body = admin.call("POST", "/api/v1/query", {"table": "comments", "columns": ["id", "host_name", "author", "comment"], "headers": ["Filter: comment ~ ^matrix "], "backends": [backend]})
            ids = {row["host_name"]: row["id"] for row in body.get("rows", [])}
            if len(ids) == 2:
                break
            time.sleep(0.5)
        check(f"{backend}: the comments are there, by admin", (sorted(ids), {r["author"] for r in body["rows"]}), (["db1", "web1"], {"admin"}))

        # user -> rows of each table. A number is a count of rows, 403 a
        # refusal for want of a role.
        full = {"hosts": 11, "services": 36, "hostgroups": 7, "hostsbygroup": 11, "comments": "some", "log": "some", "columns": "some"}
        want = {
            "admin": {**full, "contacts": 4, "contactgroups": 1, "commands": 2, "timeperiods": 1, "status": 1},
            "viewer": {**full, "contacts": 403, "contactgroups": 403, "commands": 403, "timeperiods": 403, "status": 403},
            "ops": {"hosts": 2, "services": 9, "hostgroups": 1, "hostsbygroup": 2, "comments": 1, "log": "some", "columns": "some",
                    "contacts": 403, "contactgroups": 403, "commands": 403, "timeperiods": 403, "status": 403},
        }
        for user in ("nobody", "stranger"):
            want[user] = {**want["ops"], "hosts": 0, "services": 0, "hostgroups": 0, "hostsbygroup": 0, "comments": 0, "log": 0}
        column = {"hosts": "name", "services": "description", "hostgroups": "name", "hostsbygroup": "name", "comments": "id", "log": "time",
                  "columns": "name", "contacts": "name", "contactgroups": "name", "commands": "name", "timeperiods": "name", "status": "program_start"}
        for user in USERS:
            for table, expected in want[user].items():
                got = clients[user].rows(backend, table, [column[table]])
                limited_user = user in ("ops", "nobody", "stranger")
                if closed and limited_user and expected != 403 and table != "columns":
                    expected = "closed"
                if expected == "some":
                    got = "some" if isinstance(got, int) and got > 0 else got
                check(f"{backend}: {user} reads {table}", got, expected)
        check(f"{backend}: ops' services are those of web1, web2 and db1/postgres",
              ops_services(clients["ops"], backend), "closed" if closed else ["db1/postgres"] + [f"web{n}/{s}" for n in (1, 2) for s in ("cert", "http", "https", "ping")])
        status, body = clients["ops"].call("POST", "/api/v1/stats", {"table": "services", "headers": ["Stats: state >= 0"], "backends": [backend]})
        got = "closed" if body.get("errors") else body["groups"][0]["values"][0]
        check(f"{backend}: ops' totals count the same services", got, "closed" if closed else 9.0)

        # user -> status of each command.
        def commands(user):
            c = clients[user]
            return {
                "comment on web1": c.command(backend, "ADD_HOST_COMMENT", "web1", 1, "x", f"by {user}"),
                "comment on db1": c.command(backend, "ADD_HOST_COMMENT", "db1", 1, "x", f"by {user}"),
                "comment on web1/http": c.command(backend, "ADD_SVC_COMMENT", "web1", "http", 1, "x", f"by {user}"),
                "comment on db1/postgres": c.command(backend, "ADD_SVC_COMMENT", "db1", "postgres", 1, "x", f"by {user}"),
                "comment on db1/disk": c.command(backend, "ADD_SVC_COMMENT", "db1", "disk", 1, "x", f"by {user}"),
                "recheck web1": c.command(backend, "SCHEDULE_FORCED_HOST_CHECK", "web1", int(time.time())),
                "delete admin's comment on db1": c.command(backend, "DEL_HOST_COMMENT", ids.get("db1", 0)),
            }
        everything = dict.fromkeys(["comment on web1", "comment on db1", "comment on web1/http", "comment on db1/postgres", "comment on db1/disk",
                                    "recheck web1", "delete admin's comment on db1"], 403)
        ops = {**everything, "comment on web1": 200, "comment on web1/http": 200, "comment on db1/postgres": 200, "recheck web1": 200}
        wanted = {"viewer": everything, "nobody": everything, "stranger": everything, "ops": everything if closed else ops,
                  "admin": dict.fromkeys(everything, 200)}
        for user in ("viewer", "nobody", "stranger", "ops", "admin"):
            got = commands(user)
            for name in everything:
                check(f"{backend}: {user}: {name}", got[name], wanted[user][name])
        check(f"{backend}: ops deletes the comment on web1", clients["ops"].command(backend, "DEL_HOST_COMMENT", ids.get("web1", 0)), 403 if closed else 200)

        # What was sent is by the user who sent it, whatever author they gave.
        time.sleep(2)
        status, body = admin.call("POST", "/api/v1/query", {"table": "comments", "columns": ["author", "comment"], "headers": ["Filter: comment ~ ^by "], "backends": [backend]})
        authors = sorted({(row["author"], row["comment"]) for row in body["rows"]})
        expected = [("admin", "by admin")] + ([] if closed else [("ops", "by ops")])
        check(f"{backend}: comments carry their sender's name, and only the allowed ones arrived", authors, expected)

    for backend in ("naemon", "checkd"):
        events(admin, backend)
    for backend in ("naemon", "checkd"):
        config(clients, backend)

    status, body = admin.call("GET", "/api/v1/audit")
    refused = [row for row in body if row["action"] == "command refused"]
    check("refused commands are in the audit log", len(refused) > 0, True)
    check("the audit log needs a role", clients["ops"].call("GET", "/api/v1/audit")[0], 403)
    check("logout ends the session", (admin.call("POST", "/api/v1/logout")[0], admin.call("GET", "/api/v1/session")[0]), (200, 401))


def events(admin, backend):
    """A change of a state is told to those who listen, by its backend's name."""
    import threading
    seen = []
    request = urllib.request.Request(admin.base + "/api/v1/events")

    def listen():
        try:
            with admin.opener.open(request, timeout=20) as stream:
                for line in stream:
                    seen.append(line.decode().strip())
        except OSError:
            pass

    threading.Thread(target=listen, daemon=True).start()
    time.sleep(3)
    state = 2 if admin.rows(backend, "services", ["state"], ["Filter: host_name = passive1", "Filter: description = b", "Filter: state = 0"]) == 1 else 0
    admin.command(backend, "PROCESS_SERVICE_CHECK_RESULT", "passive1", "b", state, "for the events")
    told = False
    for _ in range(40):
        told = any(line == "data: " + json.dumps({"backend": backend}, separators=(",", ":")) for line in seen)
        if told:
            break
        time.sleep(0.25)
    check(f"{backend}: a change of state is told to those who listen", told, True)
    admin.command(backend, "PROCESS_SERVICE_CHECK_RESULT", "passive1", "b", 0, "fine")


def config(clients, backend):
    """Changing the config: for admin only, checked by the engine before
    anything is written, and taken up by the engine without losing state."""
    admin = clients["admin"]
    path = f"/api/v1/config/{backend}"
    directory = os.path.join(HERE, "run", backend, "managed")
    print(f"\n== config of {backend}")
    for user in ("ops", "viewer", "stranger"):
        check(f"{backend}: {user} may not read the config", clients[user].call("GET", path)[0], 403)
        check(f"{backend}: {user} may not change it", clients[user].call("POST", path, {"revision": "", "change": {"kind": "delete", "name": "x"}})[0], 403)
    status, state = admin.call("GET", path)
    check(f"{backend}: admin reads the config", (status, state.get("hosts"), state.get("templates")), (200, [], {"host": ["demo-host"], "service": ["demo-service"]}))
    check(f"{backend}: the engine's commands are there to choose from", state["choices"]["commands"], ["demo", "notify"])
    host = {"name": "added1", "alias": "Added by the matrix", "address": "192.0.2.80", "use": "demo-host", "hostgroups": ["web"], "contact_groups": ["admins"],
            "contacts": [], "services": [{"description": "extra", "use": "demo-service", "check_command": "demo!extra!30!0", "servicegroups": [], "contacts": ["ops"], "contact_groups": []}]}
    put = lambda host, revision=None, **more: admin.call("POST", path, {"revision": revision or state["revision"], "change": {"kind": "put", "host": host}, **more})

    # What is refused before the engine is asked.
    check(f"{backend}: a template that is none", put({**host, "use": "nothing"})[0], 400)
    check(f"{backend}: a command the engine has not", put({**host, "check_command": "rm!-rf"})[0], 400)
    check(f"{backend}: a value of two lines", put({**host, "alias": "a\ndefine command {"})[0], 400)
    check(f"{backend}: a value with a comment sign", put({**host, "alias": "a ; b"})[0], 400)
    check(f"{backend}: a name that is a path", put({**host, "name": "../x"})[0], 400)
    check(f"{backend}: a group the engine has not", put({**host, "hostgroups": ["nothing"]})[0], 400)
    check(f"{backend}: an old revision", put(host, revision="0" * 24)[0], 409)

    # What the engine itself refuses: a host it already has elsewhere.
    status, body = put({**host, "name": "web1"})
    check(f"{backend}: the engine's verifier refuses a second web1", (status, bool(body.get("output"))), (422, True))
    check(f"{backend}: and nothing was written", os.listdir(directory), [])

    # Only checked.
    status, body = put(host, dry_run=True)
    check(f"{backend}: a dry run is checked and not written", (status, body.get("verified"), body.get("applied"), os.listdir(directory)), (200, True, False, []))
    check(f"{backend}: it shows the file", "host_name" in body.get("text", "") and "service_description  extra" in body.get("text", ""), True)

    # For real, with a comment on another host that must outlast it.
    admin.command(backend, "ADD_HOST_COMMENT", "web2", 1, "x", "outlasts the reload")
    time.sleep(1)
    status, body = put(host)
    check(f"{backend}: the host is added", (status, body.get("applied")), (200, True))
    check(f"{backend}: the engine has it, with its service", (admin.rows(backend, "hosts", ["name"], ["Filter: name = added1"]), admin.rows(backend, "services", ["description"], ["Filter: host_name = added1"])), (1, 1))
    check(f"{backend}: in its host group", admin.rows(backend, "hosts", ["name"], ["Filter: name = added1", "Filter: groups >= web"]), 1)
    check(f"{backend}: ops, a contact of its service, sees the service", clients["ops"].rows(backend, "services", ["description"], ["Filter: host_name = added1"]), 1)
    check(f"{backend}: the comment is still there", admin.rows(backend, "comments", ["id"], ["Filter: comment = outlasts the reload"]), 1)
    status, state = admin.call("GET", path)
    check(f"{backend}: nuthatch reads back what it wrote", [h["name"] for h in state["hosts"]], ["added1"])
    check(f"{backend}: field by field", {k: state["hosts"][0].get(k) for k in ("alias", "address", "use", "hostgroups", "contact_groups")},
          {"alias": "Added by the matrix", "address": "192.0.2.80", "use": "demo-host", "hostgroups": ["web"], "contact_groups": ["admins"]})
    check(f"{backend}: a second host of the name is refused", put(host)[0], 400)

    # Renamed, then taken away.
    status, body = admin.call("POST", path, {"revision": state["revision"], "change": {"kind": "put", "host": {**host, "name": "added2"}, "previous": "added1"}})
    check(f"{backend}: the host is renamed", (status, body.get("applied"), os.listdir(directory)), (200, True, ["added2.cfg"]))
    check(f"{backend}: the engine has the new name only", (admin.rows(backend, "hosts", ["name"], ["Filter: name = added2"]), admin.rows(backend, "hosts", ["name"], ["Filter: name = added1"])), (1, 0))
    status, body = admin.call("POST", path, {"revision": body.get("revision"), "change": {"kind": "delete", "name": "added2"}})
    check(f"{backend}: the host is taken away", (status, body.get("applied"), os.listdir(directory)), (200, True, []))
    check(f"{backend}: the engine has it no more", admin.rows(backend, "hosts", ["name"], ["Filter: name ~ ^added"]), 0)
    check(f"{backend}: the comment is still there, after three reloads", admin.rows(backend, "comments", ["id"], ["Filter: comment = outlasts the reload"]), 1)


def ops_services(client, backend):
    status, body = client.call("POST", "/api/v1/query", {"table": "services", "columns": ["host_name", "description"], "sort": [{"column": "host_name"}, {"column": "description"}], "backends": [backend]})
    if body.get("errors"):
        return "closed"
    return [f"{row['host_name']}/{row['description']}" for row in body["rows"]]


